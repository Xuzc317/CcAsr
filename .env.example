# CcAsr 环境变量模板
# 复制此文件为 .env 并填写实际值：cp .env.example .env（Windows: copy .env.example .env）
# .env 已被 .gitignore 忽略，切勿提交到 git

# ══════════════════════════════════════════════════════════
# 会议纪要所需的 LLM（OpenAI 兼容接口）
# ══════════════════════════════════════════════════════════
# 转录本身不需要 LLM；只有自动生成会议纪要需要。

# API 地址（不含 /chat/completions 后缀）
# DeepSeek 官方：https://api.deepseek.com
CCASR_LLM_API_BASE=https://api.deepseek.com

# API Key —— 必须填真实值，占位符会导致纪要生成失败
CCASR_LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# 模型名称
#   DeepSeek:  deepseek-chat（对话） / deepseek-reasoner（推理）
#   OpenAI:    gpt-4o
#   Moonshot:  moonshot-v1-8k
# 注意：DeepSeek 并没有 "deepseek-flash" 这个模型名，填错会报模型不存在
CCASR_LLM_MODEL=deepseek-chat

# 模型最大上下文长度（tokens），超过此长度将截断转录
# 常见值：64000 (DeepSeek), 128000 (GPT-4o), 1000000 (Gemini)
CCASR_LLM_MAX_CONTEXT=64000

# ══════════════════════════════════════════════════════════
# 通用配置（可选）
# ══════════════════════════════════════════════════════════
# 输出目录（默认 ~/CcAsr/output，Windows 为 C:\Users\<你>\CcAsr\output）
# CCASR_OUTPUT_DIR=
# 详细日志（1 开启 / 0 关闭，默认 0）
# CCASR_DEBUG=0

# ══════════════════════════════════════════════════════════
# 多语种 ASR 路由（可选，默认 auto）
# ══════════════════════════════════════════════════════════
# auto（默认）：
#   zh / yue / en / ja / ko  → 本地 SenseVoice（带说话人分离）
#   其它语种                  → faster-whisper（多语种，但不做说话人分离）
# 也可强制指定：sensevoice | whisper | doubao
# CCASR_ASR_ROUTING=auto

# ── faster-whisper（多语种兜底）────────────────────────────
# 模型档位：tiny / base / small / medium / large-v3
# ⚠️ 中文请勿使用 small 以下档位
#    （实测 tiny 会把"语音识别"听成"與因時別"）
# CCASR_WHISPER_MODEL=small
# CCASR_WHISPER_DEVICE=cpu
# CCASR_WHISPER_COMPUTE_TYPE=int8
# CCASR_WHISPER_CPU_THREADS=8

# ══════════════════════════════════════════════════════════
# 豆包云端后端（可选，仅 CCASR_ASR_ROUTING=doubao 时需要）
# ══════════════════════════════════════════════════════════
# 新版控制台（推荐，只需一个 APP Key）：
# DOUBAO_ASR_API_KEY=
# 旧版控制台（APP ID + Access Token）：
# DOUBAO_ASR_APP_ID=
# DOUBAO_ASR_ACCESS_TOKEN=
# 资源 ID：豆包录音文件识别模型2.0（默认）/ 1.0 为 volc.bigasr.auc
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc
# 轮询超时（秒）
# DOUBAO_ASR_POLL_TIMEOUT=1800
#
# ⚠️ 注意：豆包后端仅接受**公网可访问的音频 URL**（wav/mp3/ogg），
# 不接受文件直传。本地文件需先上传对象存储（如火山 TOS）获取 URL。
# 因此它在当前的「上传录音」流程中不可直接用，见 README 说明。

# ══════════════════════════════════════════════════════════
# 兼容说明
# ══════════════════════════════════════════════════════════
# 旧版 WINASR_ 前缀仍可被读取，但会打印弃用警告。建议统一使用 CCASR_ 前缀。
