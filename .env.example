# CcAsr LLM 配置（AI 总结功能）
# 复制此文件为 .env 并填写实际值

# OpenAI 兼容 API 地址（不含 /chat/completions 后缀）
CCASR_LLM_API_BASE=https://api.xiaomimimo.com/v1

# API Key
CCASR_LLM_API_KEY=your_api_key_here

# 模型名称
CCASR_LLM_MODEL=mimo-v2.5

# 模型最大上下文长度（tokens），超过此长度将分段处理
# 常见值：128000 (GPT-4o), 200000 (Claude), 1000000 (Gemini)
CCASR_LLM_MAX_CONTEXT=1000000

# ── 通用配置（可选）──────────────────────────────────────────
# 输出目录（默认 ~/CcAsr/output）
# CCASR_OUTPUT_DIR=
# 详细日志（1 开启 / 0 关闭，默认 0）
# CCASR_DEBUG=0

# ── ASR 后端选择（可选，默认 sensevoice 本地识别）──────────────
# CCASR_BACKEND=sensevoice    # 本地 FunASR（默认，离线免费）
# CCASR_BACKEND=doubao        # 火山引擎豆包录音文件识别（云端，按量计费）

# ── 豆包云端后端配置（仅 CCASR_BACKEND=doubao 时需要）─────────
# 新版控制台（推荐，只需一个 APP Key）：
# DOUBAO_ASR_API_KEY=
# 旧版控制台（APP ID + Access Token）：
# DOUBAO_ASR_APP_ID=
# DOUBAO_ASR_ACCESS_TOKEN=
# 资源 ID：豆包录音文件识别模型2.0（默认）/ 1.0 为 volc.bigasr.auc
# DOUBAO_ASR_RESOURCE_ID=volc.seedasr.auc
# 轮询超时（秒）
# DOUBAO_ASR_POLL_TIMEOUT=1800
# 注意：豆包后端仅接受公网可访问的音频 URL（wav/mp3/ogg），
# 本地文件需先上传对象存储（如火山 TOS）获取 URL。

# ── 兼容说明 ──────────────────────────────────────────────
# 旧版 WINASR_ 前缀仍可被读取，但会打印弃用警告。
# 建议统一使用 CCASR_ 前缀。
